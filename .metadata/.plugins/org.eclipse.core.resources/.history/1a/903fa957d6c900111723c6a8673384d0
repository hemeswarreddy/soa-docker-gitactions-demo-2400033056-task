package com.klef.soa.exam.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.klef.soa.exam.entity.StorageUnit;
import com.klef.soa.exam.service.StorageUnitService;

@RestController
@RequestMapping("/storageunit")
public class StorageUnitController {

    @Autowired
    private StorageUnitService service;

    @GetMapping("/")
    public String home() {
        return "This is the storage unit home page";
    }

    @PostMapping("/add")
    public ResponseEntity<StorageUnit> addStorageUnit(@RequestBody StorageUnit storageUnit) {
        StorageUnit savedUnit = service.addstorageunit(storageUnit);
        return ResponseEntity.status(HttpStatus.CREATED).body(savedUnit);
    }

    @GetMapping("/displayall")
    public ResponseEntity<List<StorageUnit>> displayAllStorageUnits() {
        List<StorageUnit> storageUnits = service.displayallstorageUnits();
        return ResponseEntity.ok(storageUnits);
    }

    @PutMapping("/update")
    public ResponseEntity<?> updateStorageUnit(@RequestBody StorageUnit storageUnit) {
        StorageUnit updatedUnit = service.updatestoragesnit(storageUnit);

        if (updatedUnit != null) {
            return ResponseEntity.ok(updatedUnit);
        }

        return ResponseEntity.status(HttpStatus.NOT_FOUND)
                .body("Storage unit ID not found to update");
    }

    @DeleteMapping("/delete/{id}")
    public ResponseEntity<String> deleteStorageUnit(@PathVariable Long id) {
        String message = service.deletestoragesnitById(id);
        return ResponseEntity.ok(message);
    }
}