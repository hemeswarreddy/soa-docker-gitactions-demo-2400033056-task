package com.klef.soa.exam.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.klef.soa.exam.entity.StorageUnit;
import com.klef.soa.exam.service.StorageUnitService;

import io.swagger.v3.oas.annotations.parameters.RequestBody;

@RestController
@RequestMapping("/storageunit")
public class StorgaeUnitController {
	
	@Autowired
    private StorageUnitService service;

    @GetMapping("/")
    public String home() {
        return "This is the storage unit home page";
    }
    
    @PostMapping("/add")
    public ResponseEntity<StorageUnit> addStorageUnit(@RequestBody StorageUnit storageUnit) {
        StorageUnit output = service.addstorageunit(storageUnit);
        return ResponseEntity.status(200).body(output);
    }
    
    @GetMapping("/displayall")
    public ResponseEntity<List<StorageUnit>> displayAllStorageUnits() {
        List<StorageUnit> output = service.displayallstorageUnits();
        return ResponseEntity.status(200).body(output);
    }
    
    @PutMapping("/update")
    public ResponseEntity<?> updateStorageUnit(@RequestBody StorageUnit storageUnit) {
        StorageUnit output = service.updatestoragesnit(storageUnit);

        if (output != null) {
            return ResponseEntity.ok(output);
        }
        else {
        return ResponseEntity.status(400).body("ID not found to delete");
        }
    }

}
